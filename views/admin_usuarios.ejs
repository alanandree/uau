<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Usuarios - Fixoo</title>
  <link rel="stylesheet" href="/css/auth.css">
  <style>
    body { background: linear-gradient(180deg, #1e293b 0%, #3b82f6 100%); }
    .admin-table { width:100%; border-collapse:collapse; background:rgba(255,255,255,0.95); border-radius:12px; overflow:hidden; color:#1e293b; font-size:13px; }
    .admin-table th { background:#3b82f6; color:#fff; padding:10px 8px; text-align:left; font-size:12px; white-space:nowrap; }
    .admin-table td { padding:8px; border-bottom:1px solid #e2e8f0; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .admin-table tr:hover { background:#f1f5f9; }
    .badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600; }
    .scroll { overflow-x:auto; }
    .form-wrapper h1 { font-size:22px; }
    .form-wrapper { max-width:98%; }
    .nav-tabs { display:flex; gap:0; margin-bottom:24px; border-bottom:2px solid #e2e8f0; }
    .nav-tabs a { padding:10px 20px; font-size:14px; font-weight:600; text-decoration:none; color:#64748b; border-bottom:2px solid transparent; margin-bottom:-2px; transition:all 0.2s; }
    .nav-tabs a.active { color:#3b82f6; border-bottom-color:#3b82f6; }
    .nav-tabs a:hover { color:#1e293b; }
  </style>
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <div class="split-container" style="flex-direction:column;height:auto;min-height:100vh">
    <div style="background:rgba(255,255,255,0.95);padding:16px 32px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e2e8f0">
      <strong style="color:#3b82f6;font-size:20px;">FIXOO - Admin</strong>
      <a href="/admin/login?logout=1" style="color:#dc2626;font-size:13px;text-decoration:none" onclick="document.cookie='connect.sid=;max-age=0'">Sair</a>
    </div>
    <div class="left-side" style="padding:32px">
      <div class="form-wrapper">
        <h1 style="color:#1e293b">Usuarios Cadastrados</h1>
        <div class="nav-tabs">
          <a href="/admin">Colaboradores</a>
          <a href="/admin/usuarios" class="active">Usuarios</a>
        </div>
        <p style="color:#64748b;margin-bottom:20px;font-size:14px">Total: <%= usuarios.length %></p>
        <% if (usuarios.length > 0) { %>
          <div class="scroll">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nome</th>
                  <th>Email</th>
                  <th>Telefone</th>
                  <th>Enderecos</th>
                  <th>Rating</th>
                  <th>Avaliacoes</th>
                  <th>Cadastro</th>
                </tr>
              </thead>
                  <tbody>
                <% usuarios.forEach(function(u) { %>
                  <tr>
                    <td data-label="ID"><%= u.id %></td>
                    <td data-label="Nome"><strong><%= u.name %></strong></td>
                    <td data-label="Email"><%= u.email %></td>
                    <td data-label="Telefone"><%= u.phone || '-' %></td>
                    <td data-label="Enderecos" style="font-size:11px;">
                      <% 
                        var enderecos = [];
                        try { enderecos = JSON.parse(u.addresses || '[]'); } catch(e) {}
                      %>
                      <%= enderecos.length %> endereco(s)
                    </td>
                    <td data-label="Rating"><%= u.cliente_rating || 0 %></td>
                    <td data-label="Avaliacoes"><%= u.cliente_total_avaliacoes || 0 %></td>
                    <td data-label="Cadastro" style="font-size:11px;white-space:nowrap"><%= u.createdAt %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p style="color:#94a3b8;font-style:italic">Nenhum usuario cadastrado ainda.</p>
        <% } %>
        <a href="/" style="display:inline-block;margin-top:20px;color:#3b82f6;font-size:14px">← Voltar ao site</a>
      </div>
    </div>
  </div>
</body>
</html>
