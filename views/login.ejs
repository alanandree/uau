<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <script>
    function toggleSenha(el) {
      var input = el.previousElementSibling;
      var showing = el.getAttribute('data-showing') === 'true';
      el.innerHTML = showing
        ? '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
        : '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
      input.type = showing ? 'password' : 'text';
      el.setAttribute('data-showing', showing ? 'false' : 'true');
    }
  </script>
  <div class="split-container">
    <div class="left-side">
      <div class="form-wrapper">
        <h1>Entrar</h1>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
        <% if (req.query.reset === 'ok') { %>
          <div class="alert alert-success">Senha redefinida com sucesso! Faça login com sua nova senha.</div>
        <% } %>

        <form action="/login" method="POST">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" value="<%= email %>" required>
          </div>
          <div class="form-group">
            <label for="password">Senha</label>
            <div style="position:relative">
              <input type="password" name="password" id="password" required style="padding-right:40px">
              <span onclick="toggleSenha(this)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);cursor:pointer;user-select:none;display:flex;padding:4px;color:#9ca3af" data-showing="false">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
            </div>
          </div>
          <button type="submit" class="btn btn-primary">Entrar</button>
          <p style="text-align:center;margin-top:12px"><a href="/esqueci-senha" style="color:#3b82f6;font-size:13px;text-decoration:none">Esqueceu sua senha?</a></p>
        </form>

        <p class="link">Não tem conta? <a href="/register">Cadastre-se</a></p>
      </div>
    </div>
    <div class="right-side">
      <a href="/" style="text-decoration:none">
        <div class="brand-name">
          <span>F</span><span>I</span><span>X</span><span class="wave">O</span><span class="wave">O</span>
        </div>
      </a>
    </div>
  </div>
</body>
</html>
