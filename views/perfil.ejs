<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Perfil</title>
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/perfil.css">
</head>
<body>
  <header class="top-header">
    <a href="/" class="brand-link">FIXOO</a>
  </header>
      <div class="profile-container">
    <aside class="profile-sidebar">
      <div class="avatar-section">
        <form action="/perfil/atualizar" method="POST" enctype="multipart/form-data" id="avatar-form">
          <div class="avatar-wrapper">
            <img src="<%= user.profile_picture ? user.profile_picture : '/img/default-avatar.svg' %>" alt="Avatar" class="avatar" id="avatar-preview">
            <label for="profile_picture" class="avatar-overlay">
              <span>Alterar</span>
            </label>
            <input type="file" name="profile_picture" id="profile_picture" accept="image/*" style="display:none" onchange="document.getElementById('avatar-form').submit()">
          </div>
        </form>
        <h2><%= user.name %></h2>
        <p class="member-since">Membro desde <%= new Date(user.createdAt).toLocaleDateString('pt-BR') %></p>
        <% if (user.cliente_total_avaliacoes > 0) { %>
          <div style="margin-top:8px;font-size:13px;color:#6b7280">
            Avaliação como cliente:
            <% var r = Math.round(user.cliente_rating); for (var i = 1; i <= 5; i++) { %>
              <span style="color:<%= i <= r ? '#f59e0b' : '#d1d5db' %>;font-size:16px">★</span>
            <% } %>
            <span style="margin-left:4px"><%= user.cliente_rating.toFixed(1) %> (<%= user.cliente_total_avaliacoes %>)</span>
          </div>
        <% } else { %>
          <p style="margin-top:8px;font-size:12px;color:#9ca3af">Nenhuma avaliação como cliente ainda.</p>
        <% } %>
      </div>
      <nav class="sidebar-nav">
        <a href="#dados" class="active" data-tab="dados">Dados Pessoais</a>
        <a href="#enderecos" data-tab="enderecos">Endereços</a>
        <a href="#pedidos" data-tab="pedidos">Pedidos</a>
        <a href="#chat" data-tab="chat">Chat</a>
        <a href="#avaliacoes" data-tab="avaliacoes">Avaliações</a>
        <a href="#pagamentos" data-tab="pagamentos">Formas de Pagamento</a>
        <a href="#config" data-tab="config">Configurações</a>
      </nav>
      <div class="sidebar-actions">
        <a href="/" class="btn-sidebar">Ir para o Site</a>
        <a href="/logout" class="btn-sidebar btn-sidebar-danger">Sair</a>
      </div>
    </aside>

    <main class="profile-content">
      <!-- NOTIFICACAO -->
      <div id="notificacao-banner" style="display:none;background:#dcfce7;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;margin-bottom:20px;font-size:14px;color:#16a34a;font-weight:500"></div>

      <!-- DADOS PESSOAIS -->
      <section id="dados" class="tab-content active">
        <h1>Dados Pessoais</h1>
        <form action="/perfil/atualizar" method="POST" enctype="multipart/form-data" class="profile-form">
          <div class="form-group">
            <label for="name">Nome</label>
            <input type="text" name="name" id="name" value="<%= user.name %>" required>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" value="<%= user.email %>" disabled>
            <small>O email não pode ser alterado</small>
          </div>
          <div class="form-group">
            <label for="phone">Telefone</label>
            <input type="text" name="phone" id="phone" value="<%= user.phone || '' %>" placeholder="(XX) XXXXX-XXXX">
          </div>
          <button type="submit" class="btn btn-primary">Salvar Alterações</button>
        </form>
      </section>

      <!-- ENDEREÇOS -->
      <section id="enderecos" class="tab-content">
        <h1>Endereços Salvos</h1>
        <div class="items-list">
          <% if (user.addresses && user.addresses.length > 0) { %>
            <% user.addresses.forEach(function(addr) { %>
              <div class="item-card">
                <div class="item-info">
                  <strong><%= addr.label %></strong>
                  <p><%= addr.address %></p>
                </div>
                <form action="/perfil/endereco/excluir" method="POST" class="inline-form">
                  <input type="hidden" name="id" value="<%= addr.id %>">
                  <button type="submit" class="btn-small btn-danger">Excluir</button>
                </form>
              </div>
            <% }); %>
          <% } else { %>
            <p class="empty-msg">Nenhum endereço salvo.</p>
          <% } %>
        </div>
        <details class="add-item">
          <summary>Adicionar Endereço</summary>
          <form action="/perfil/endereco" method="POST" class="profile-form">
            <div class="form-group">
              <label for="label">Identificação (ex: Casa, Trabalho)</label>
              <input type="text" name="label" id="label" required>
            </div>
            <div class="form-group">
              <label for="address">Endereço</label>
              <input type="text" name="address" id="address" required>
            </div>
            <button type="submit" class="btn btn-primary">Adicionar</button>
          </form>
        </details>
      </section>

      <!-- HISTÓRICO DE PEDIDOS -->
      <section id="pedidos" class="tab-content">
        <h1>Histórico de Pedidos</h1>
        <% if (orders.length > 0) { %>
          <div class="items-list">
            <% orders.forEach(function(order) { %>
              <div class="item-card">
                <div class="item-info">
                  <strong><%= order.description %></strong>
                  <p>R$ <%= order.value ? order.value.toFixed(2) : '0,00' %></p>
                  <small><%= new Date(order.date).toLocaleDateString('pt-BR') %></small>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-msg">Nenhum pedido realizado ainda.</p>
        <% } %>
      </section>

      <!-- CHAT -->
      <section id="chat" class="tab-content">
        <h1>Chat com Profissionais</h1>
        <div style="display:flex;gap:16px;min-height:400px;flex-wrap:wrap">
          <div style="flex:1;min-width:200px;max-width:260px;border-right:1px solid #e5e7eb;padding-right:12px">
            <p style="font-weight:600;margin-bottom:8px">Pedidos</p>
            <div id="chat-pedidos-lista"><p style="color:#9ca3af;font-size:13px">Carregando...</p></div>
          </div>
          <div style="flex:2;min-width:280px;display:flex;flex-direction:column">
            <p id="chat-titulo-cliente" style="font-weight:600;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid #e5e7eb"></p>
            <div style="flex:1;min-height:300px;overflow-y:auto;padding:12px;background:#f9fafb;border-radius:8px;display:flex;flex-direction:column;gap:8px" id="chat-msgs-cliente">
              <div style="text-align:center;color:#9ca3af;margin-top:80px">Selecione um pedido para conversar.</div>
            </div>
            <div style="display:none;gap:8px;margin-top:8px" id="chat-input-row-cliente">
              <input type="text" id="chat-input-cliente" placeholder="Digite sua mensagem..." style="flex:1;padding:10px;border:1px solid #d1d5db;border-radius:8px;font-size:14px" onkeypress="if(event.key==='Enter')sendMsgCliente()">
              <button onclick="sendMsgCliente()" style="padding:10px 18px;background:#3b82f6;color:#fff;border:none;border-radius:8px;font-weight:600;cursor:pointer">Enviar</button>
            </div>
          </div>
        </div>
      </section>

      <!-- AVALIAÇÕES -->
      <section id="avaliacoes" class="tab-content">
        <h1>Avaliações Feitas</h1>
        <% if (reviews.length > 0) { %>
          <div class="items-list">
            <% reviews.forEach(function(rev) { %>
              <div class="item-card">
                <div class="item-info">
                  <strong><%= rev.establishment_name %></strong>
                  <div class="stars">
                    <% for (var i = 0; i < 5; i++) { %>
                      <span class="star <%= i < rev.rating ? 'filled' : '' %>">★</span>
                    <% } %>
                  </div>
                  <p><%= rev.comment %></p>
                  <small><%= new Date(rev.date).toLocaleDateString('pt-BR') %></small>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-msg">Nenhuma avaliação feita ainda.</p>
        <% } %>
      </section>

      <!-- FORMAS DE PAGAMENTO -->
      <section id="pagamentos" class="tab-content">
        <h1>Formas de Pagamento</h1>
        <div class="items-list">
          <% if (user.paymentMethods && user.paymentMethods.length > 0) { %>
            <% user.paymentMethods.forEach(function(m) { %>
              <div class="item-card">
                <div class="item-info">
                  <strong><%= m.type %></strong>
                  <p><%= m.info %></p>
                </div>
                <form action="/perfil/pagamento/excluir" method="POST" class="inline-form">
                  <input type="hidden" name="id" value="<%= m.id %>">
                  <button type="submit" class="btn-small btn-danger">Excluir</button>
                </form>
              </div>
            <% }); %>
          <% } else { %>
            <p class="empty-msg">Nenhuma forma de pagamento salva.</p>
          <% } %>
        </div>
        <details class="add-item">
          <summary>Adicionar Forma de Pagamento</summary>
          <form action="/perfil/pagamento" method="POST" class="profile-form">
            <div class="form-group">
              <label for="type">Tipo</label>
              <select name="type" id="type" required>
                <option value="">Selecione...</option>
                <option value="Cartão de Crédito">Cartão de Crédito</option>
                <option value="Cartão de Débito">Cartão de Débito</option>
                <option value="PIX">PIX</option>
                <option value="Boleto">Boleto</option>
              </select>
            </div>
            <div class="form-group">
              <label for="info">Informação (número do cartão, chave PIX, etc.)</label>
              <input type="text" name="info" id="info" required>
            </div>
            <button type="submit" class="btn btn-primary">Adicionar</button>
          </form>
        </details>
      </section>

      <!-- CONFIGURAÇÕES -->
      <section id="config" class="tab-content">
        <h1>Configurações</h1>
        <p class="empty-msg">Configurações adicionais em breve.</p>
      </section>
    </main>
  </div>

  <script>
    let pedidosCliente = [];
    let chatPedidoIdCliente = null;
    let chatTimerCliente = null;

    document.querySelectorAll('.sidebar-nav a').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        document.querySelectorAll('.sidebar-nav a').forEach(function(a) { a.classList.remove('active'); });
        document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        var tab = this.getAttribute('data-tab');
        document.getElementById(tab).classList.add('active');
        if (tab === 'chat') loadPedidosCliente();
      });
    });

    var hash = window.location.hash.replace('#', '');
    if (hash) {
      var el = document.querySelector('[data-tab="' + hash + '"]');
      if (el) el.click();
    }

    document.getElementById('profile_picture').addEventListener('change', function() {
      if (this.files && this.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('avatar-preview').src = e.target.result;
        };
        reader.readAsDataURL(this.files[0]);
      }
    });

    function loadPedidosCliente() {
      fetch('/api/pedidos/cliente', { credentials: 'same-origin' }).then(function(r) { return r.json(); }).then(function(data) {
        pedidosCliente = data;
        var lista = document.getElementById('chat-pedidos-lista');
        if (!data.length) { lista.innerHTML = '<p style="color:#9ca3af;font-size:13px">Nenhum pedido.</p>'; return; }
        lista.innerHTML = data.map(function(p) {
          var snames = Array.isArray(p.servicos) ? p.servicos.map(function(s) { return s.nome || s; }).join(', ') : '';
          return '<div class="conversa-item' + (chatPedidoIdCliente === p.id ? ' active' : '') + '" data-pedido="' + p.id + '" onclick="selectChatCliente(' + p.id + ')" style="padding:10px;border-radius:8px;cursor:pointer;margin-bottom:4px;font-size:13px">' +
            '<div style="font-weight:600">' + (p.colab_nome || 'Profissional') + '</div>' +
            '<div style="font-size:12px;color:#6b7280">#' + p.id + ' - ' + snames.substring(0, 25) + ' <span class="status-badge status-' + (p.status || 'pendente') + '" style="display:inline-block;padding:2px 8px;border-radius:8px;font-size:11px;font-weight:600;' + (p.status === 'confirmado' ? 'background:#dcfce7;color:#16a34a' : p.status === 'pendente' ? 'background:#fef3c7;color:#d97706' : 'background:#fee2e2;color:#dc2626') + '">' + (p.status || 'pendente') + '</span></div>' +
          '</div>';
        }).join('');
        if (chatPedidoIdCliente) {
          var sel = document.querySelector('.conversa-item[data-pedido="' + chatPedidoIdCliente + '"]');
          if (sel) sel.classList.add('active');
        }
        verificarNotificacoes(data);
      });
    }

    function selectChatCliente(pedidoId) {
      chatPedidoIdCliente = pedidoId;
      document.querySelectorAll('#chat-pedidos-lista .conversa-item').forEach(function(i) { i.classList.remove('active'); });
      var el = document.querySelector('.conversa-item[data-pedido="' + pedidoId + '"]');
      if (el) el.classList.add('active');
      document.getElementById('chat-titulo-cliente').textContent = 'Conversa - Pedido #' + pedidoId;
      loadMessagesCliente(pedidoId);
      document.getElementById('chat-input-row-cliente').style.display = 'flex';
    }

    function loadMessagesCliente(pedidoId) {
      var area = document.getElementById('chat-msgs-cliente');
      if (chatTimerCliente) clearInterval(chatTimerCliente);
      function fetchMsgs() {
        fetch('/api/chat/' + pedidoId, { credentials: 'same-origin' }).then(function(r) { return r.json(); }).then(function(msgs) {
          if (!msgs.length) {
            area.innerHTML = '<div style="text-align:center;color:#9ca3af;margin-top:80px">Nenhuma mensagem ainda. Envie a primeira!</div>';
            return;
          }
          area.innerHTML = msgs.map(function(m) {
            var tipo = m.tipo_remetente === 'colaborador' ? 'colab' : 'cliente';
            return '<div style="padding:8px 14px;border-radius:12px;max-width:80%;font-size:14px;line-height:1.4' + (tipo === 'colab' ? ';background:#3b82f6;color:#fff;align-self:flex-start' : ';background:#e5e7eb;color:#111827;align-self:flex-end') + '">' +
              m.mensagem +
              '<span style="font-size:10px;opacity:0.7;margin-top:4px;display:block">' + (m.nome_remetente || '') + ' - ' + new Date(m.data).toLocaleString() + '</span>' +
            '</div>';
          }).join('');
          area.scrollTop = area.scrollHeight;
        });
      }
      fetchMsgs();
      chatTimerCliente = setInterval(fetchMsgs, 3000);
    }

    function sendMsgCliente() {
      var input = document.getElementById('chat-input-cliente');
      var msg = input.value.trim();
      if (!msg || !chatPedidoIdCliente) return;
      input.value = '';
      fetch('/api/chat/' + chatPedidoIdCliente, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ mensagem: msg, tipo: 'cliente' })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) loadMessagesCliente(chatPedidoIdCliente);
      });
    }

    function verificarNotificacoes(pedidos) {
      var banner = document.getElementById('notificacao-banner');
      var aceitos = pedidos.filter(function(p) { return p.status === 'confirmado'; });
      if (aceitos.length > 0) {
        var nomes = aceitos.map(function(p) { return p.colab_nome || 'Profissional'; }).filter(function(v,i,a){return a.indexOf(v)===i;});
        banner.innerHTML = 'O profissional <strong>' + nomes.join(', ') + '</strong> aceitou seu pedido! Qualquer dúvida, entre em contato com ele via chat pelo seu perfil.';
        banner.style.display = 'block';
      } else {
        banner.style.display = 'none';
      }
    }
  </script>
</body>
</html>